    "jose": "^6.2.12",
    "next": "15.5.26",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "postcss": "^8.5.28",
    "prisma": "^7.10.0",
