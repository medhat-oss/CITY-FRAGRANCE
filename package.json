  "private": true,
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "clean": "node -e \"const{rmSync,existsSync}=require('fs');['.next','.open-next'].forEach(d=>{if(existsSync(d))rmSync(d,{recursive:true,force:true})})\"",
