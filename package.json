{
  "name": "city-fragrance-next",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "clean": "node -e \"const{rmSync,existsSync}=require('fs');['.next','.open-next'].forEach(d=>{if(existsSync(d))rmSync(d,{recursive:true,force:true})})\"",
    "build:cloudflare": "npm run clean && opennextjs-cloudflare build && node -e \"const {copyFileSync,mkdirSync,cpSync,existsSync}=require('fs');mkdirSync('.open-next/dist',{recursive:true});if(existsSync('.open-next/assets'))cpSync('.open-next/assets','.open-next/dist/assets',{recursive:true});if(existsSync('.open-next/worker.js'))copyFileSync('.open-next/worker.js','.open-next/dist/_worker.js')\"",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate" 
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.40.0",
    "jose": "^6.2.3",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "autoprefixer": "^10.5.0",
    "cloudinary": "^2.10.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "pg": "^8.21.0",
    "postcss": "^8.5.15",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "wrangler": "^4.102.0"
  }
}
