generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id             String   @id @default(cuid())
  orderId        String   @unique
  customerName   String
  phoneNumber    String
  email          String   @default("")
  address        String
  apartment      String   @default("")
  city           String
  governorate    String   @default("")
  items          Json
  totalPrice     Float
  status         String   @default("Pending")
  date           String
  paymentMethod  String?
  source         String   @default("WEB")
  cashierId      String?
  shiftId        String?
  shift          Shift?   @relation(fields: [shiftId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Shift {
  id                String   @id @default(cuid())
  cashierId         String
  cashierName       String
  startTime         DateTime
  endTime           DateTime?
  status            String   @default("OPEN")
  totalCash         Float    @default(0)
  totalInstaPay     Float    @default(0)
  totalVodafoneCash Float    @default(0)
  totalVisa         Float    @default(0)
  actualCash        Float?
  expectedTotal     Float?
  discrepancy       Float?
  orderCount        Int      @default(0)
  orders            Order[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Product {
  id            String   @id
  name          String
  type          String   @default("")
  category      String   @default("")
  collection    String   @default("")
  collections   Collection[]
  isDraft       Boolean  @default(true)
  badge         String   @default("")
  notes         String   @default("")
  description   String   @default("")
  orientation   String   @default("")
  concentration String   @default("")
  volume        String   @default("")
  price         Float
  costPrice     Float  @default(0)
  salePrice     Float?
  images        Json     @default("[]")
  videoUrl      String   @default("")
  stock         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Collection {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  products  Product[]
}

model GiftSet {
  id          String   @id
  name        String
  description String   @default("")
  price       Float
  costPrice   Float    @default(0)
  isDraft     Boolean  @default(true)
  image       String   @default("")
  productIds  Json     @default("[]")
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  password      String
  name          String   @default("")
  role          Role     @default(CASHIER)
  shiftPassword String   @default("123456")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ShiftLog {
  id                String   @id @default(cuid())
  userId            String
  userName          String
  shiftId           String?
  shiftStartedAt    DateTime
  shiftEndedAt      DateTime
  ordersCount       Int      @default(0)
  cashExpected      Float    @default(0)
  instapayExpected  Float    @default(0)
  vodafoneCashExpected Float @default(0)
  visaExpected      Float    @default(0)
  totalExpected     Float    @default(0)
  actualCashInDrawer Float   @default(0)
  createdAt         DateTime @default(now())

  @@index([userId])
}

model SiteSetting {
  id                      String @id @default("default")
  heroTitle               String @default("")
  heroSubtitle            String @default("")
  heroDescription         String @default("")
  announcementText        String @default("")
  heroBgImage             String @default("")
  heroBgImageDesktop      String @default("")
  heroVideoUrl            String @default("")
  heroVideoMobile         String @default("")
  moodTitle               String @default("")
  moodSubtitle            String @default("")
  moodImage               String @default("")
  moodImageDesktop        String @default("")
  moodVideoUrl            String @default("")
  moodVideoMobile         String @default("")
  heroWidth               Int    @default(1600)
  heroHeight              Int    @default(1200)
  heroMobileWidth         Int    @default(600)
  heroMobileHeight        Int    @default(800)
  heroVideoWidth          Int    @default(1600)
  heroVideoHeight         Int    @default(1200)
  heroVideoMobileWidth    Int    @default(600)
  heroVideoMobileHeight   Int    @default(800)
  moodWidth               Int    @default(900)
  moodHeight              Int    @default(650)
  moodMobileWidth         Int    @default(600)
  moodMobileHeight        Int    @default(800)
  moodVideoWidth          Int    @default(900)
  moodVideoHeight         Int    @default(506)
  moodVideoMobileWidth    Int    @default(600)
  moodVideoMobileHeight   Int    @default(800)
  womenCollectionVideoUrl String @default("")
  menCollectionVideoUrl   String @default("")
  giftSetsVideoUrl        String @default("")
  newArrivalsVideoUrl     String @default("")
  allFragrancesVideoUrl   String @default("")
  oudCollectionVideoUrl   String @default("")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model CollectionImage {
  slug        String @id
  image       String @default("")
  description String @default("")
}

enum Role {
  ADMIN
  CASHIER
}
